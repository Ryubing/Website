---

interface Props {
    href: string
    primary: boolean
    dl: string
}

const { href, primary, dl } = Astro.props

// the href is a placeholder so Astro shuts the fuck up about invalid hrefs
// we give it a valid one in the js onclick
---

<a class:list={["dl-button", primary && "primary", dl]} href="../assets/wordmark.svg">
    <slot />
</a>

<style lang="scss">
    .dl-button {
        padding: 0.9rem 1.5rem;
        border-radius: 9999px;
        font-size: 1rem;
        font-weight: 550;
        letter-spacing: 0.02em;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        transition:
            background-color 0.2s,
            filter 0.2s;
        display: inline-block;
        text-align: center;
        color: white;
        background-color: rgb(255 255 255 / 10%);

        &:hover {
            background-color: rgb(255 255 255 / 20%);
        }

        &:active {
            background-color: rgb(255 255 255 / 30%);
        }

        &.primary {
            background: linear-gradient(180deg, #FF005C 0%, #9A0239 100%);

            &:hover {
                filter: brightness(1.1);
            }

            &:active {
                filter: brightness(0.9);
            }
        }
    }
</style>

<script is:inline define:vars={{ href, dl }}>
    document.querySelector("a." + dl)
        .addEventListener('click', () => window.open(href, '_blank'))
</script>
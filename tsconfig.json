{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@lib/*": [
				"src/lib/*"
			]
		},
		"outDir": "dist",
		"types": [
			"node"
		],
		"lib": [
			"ESNext",
			"DOM"
		]
	},
	"include": [
		".astro/types.d.ts",
		"**/*",
		"src/lib/**/*",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist"
	]
}